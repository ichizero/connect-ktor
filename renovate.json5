{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    extends: ["config:recommended", "schedule:daily"],
    timezone: "Asia/Tokyo",
    // Mirrors dependabot.yml's `cooldown.default-days: 7` for every ecosystem.
    minimumReleaseAge: "7 days",
    dependencyDashboard: true,
    // Buf remote plugin versions follow their upstream project's version tags.
    customManagers: [
        {
            customType: "regex",
            managerFilePatterns: ["**/buf.gen.yaml"],
            matchStrings: [
                "remote:\\s*buf\\.build/(?<depName>protocolbuffers/(?:java|kotlin)):(?<currentValue>[^\\s]+)",
            ],
            datasourceTemplate: "github-tags",
            packageNameTemplate: "protocolbuffers/protobuf",
            versioningTemplate: "semver-coerced",
        },
        {
            customType: "regex",
            managerFilePatterns: ["**/buf.gen.yaml"],
            matchStrings: ["remote:\\s*buf\\.build/(?<depName>connectrpc/kotlin):(?<currentValue>[^\\s]+)"],
            datasourceTemplate: "github-tags",
            packageNameTemplate: "connectrpc/connect-kotlin",
            versioningTemplate: "semver-coerced",
        },
    ],
    packageRules: [
        {
            description: "Group github/codeql-action updates (mirrors dependabot.yml's `codeql-action` group).",
            matchManagers: ["github-actions"],
            matchPackageNames: ["github/codeql-action", "github/codeql-action/**"],
            groupName: "codeql-action",
        },
        {
            description: "Group all npm/pnpm updates (mirrors dependabot.yml's `docs-site` group, which matched every npm dependency).",
            matchManagers: ["npm"],
            groupName: "docs-site",
        },
        {
            description: "Auto-merge minor and patch updates once required checks and any required review pass (expanded from the old semver-patch-only auto-merge in dependabot.yml).",
            matchUpdateTypes: ["minor", "patch"],
            automerge: true,
            automergeType: "pr",
        },
    ],
}
